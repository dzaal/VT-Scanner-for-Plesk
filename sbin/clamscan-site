#!/usr/local/psa/admin/bin/php
<?php
/**
 * clamscan-site: scan one website's files with ClamAV (read-only, reports only).
 *
 * Runs as root through pm_ApiCli::callSbin(), because website files belong to
 * the subscription users and the panel user cannot read them.
 *
 *   clamscan-site <hostname>         start a scan in the background, print JSON
 *   clamscan-site --run <hostname>   (internal) the scan itself
 *
 * Uses the clamd that already runs for mail scanning (amavisd), via --fdpass,
 * so no signatures are loaded again. Only one scan runs at a time on the server;
 * a scan started while another one runs waits its turn ("queued").
 * Nothing is deleted, moved or quarantined.
 */

const DATA     = '/usr/local/psa/var/modules/virustotal-extension/data';
const CONF     = '/etc/clamd.d/amavisd.conf';
const VHOSTS   = '/var/www/vhosts/';
const MAX_LIST = 200;   // infected files listed in the result
const TIMEOUT  = 3600;  // seconds before a scan is stopped

function out(array $a): void { echo json_encode($a), "\n"; exit(0); }

$run  = ($argv[1] ?? '') === '--run';
$host = strtolower(trim((string)($run ? ($argv[2] ?? '') : ($argv[1] ?? ''))));
if (!preg_match('/^[a-z0-9][a-z0-9.\-]*\.[a-z0-9\-]{2,}$/', $host)) out(['error' => 'Invalid site name']);

$resultFile = DATA . '/vt_clam_' . preg_replace('/[^a-z0-9]/', '_', $host) . '.json';
$lockFile   = DATA . '/vt_clam.lock';

function save(string $file, array $a): void
{
    file_put_contents($file . '.tmp', json_encode($a, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES));
    @chown($file . '.tmp', 'psaadm'); @chgrp($file . '.tmp', 'psaadm'); @chmod($file . '.tmp', 0640);
    rename($file . '.tmp', $file);
}

/** Document root of the site, from Plesk's database (parent domains for WordPress subsites) */
function docroot(string $host): ?string
{
    $name = $host;
    while (substr_count($name, '.') >= 1) {
        $sql  = "SELECT h.www_root FROM hosting h JOIN domains d ON d.id = h.dom_id "
              . "WHERE d.name = '" . $name . "' AND d.htype = 'vrt_hst' AND d.status = 0 LIMIT 1";
        $root = trim((string)shell_exec('plesk db -Ne ' . escapeshellarg($sql) . ' 2>/dev/null'));
        if ($root !== '') {
            $real = realpath($root);
            return ($real && strpos($real . '/', VHOSTS) === 0 && is_dir($real)) ? $real : null;
        }
        $name = substr($name, strpos($name, '.') + 1);
    }
    return null;
}

if (!is_file(CONF) || !is_executable('/usr/bin/clamdscan')) out(['error' => 'ClamAV (clamdscan) is not available on this server']);

// ── Start ──────────────────────────────────────────────────────
if (!$run) {
    $prev = json_decode((string)@file_get_contents($resultFile), true);
    if (in_array($prev['status'] ?? '', ['running', 'queued'], true) && time() - (int)($prev['started'] ?? 0) < TIMEOUT + 600) {
        out(['started' => true, 'domain' => $host, 'already' => true]);
    }

    $root = docroot($host);
    if (!$root) out(['error' => 'Could not find the website folder of ' . $host]);

    $lock = fopen($lockFile, 'c');
    $free = $lock && flock($lock, LOCK_EX | LOCK_NB);
    if ($free) { flock($lock, LOCK_UN); }
    if ($lock) fclose($lock);
    save($resultFile, ['domain' => $host, 'status' => $free ? 'running' : 'queued', 'started' => time(),
                       'root' => substr($root, strlen(VHOSTS))]);
    exec('setsid nohup ' . escapeshellarg(PHP_BINARY) . ' ' . escapeshellarg(__FILE__)
         . ' --run ' . escapeshellarg($host) . ' >/dev/null 2>&1 &');
    out(['started' => true, 'domain' => $host]);
}

// ── Scan (background) ──────────────────────────────────────────
// Wait for any other scan to finish (one at a time, to spare the mail scanner)
$lock = fopen($lockFile, 'c');
if (!$lock || !flock($lock, LOCK_EX)) {
    save($resultFile, ['domain' => $host, 'status' => 'error', 'finished' => time(), 'message' => 'Could not start the scan']);
    exit(0);
}
ftruncate($lock, 0); fwrite($lock, $host); fflush($lock);

$started = time();
$prev    = json_decode((string)@file_get_contents($resultFile), true) ?: [];
save($resultFile, ['domain' => $host, 'status' => 'running', 'started' => $started,
                   'root' => $prev['root'] ?? '']);
$root    = docroot($host);
if (!$root) {
    save($resultFile, ['domain' => $host, 'status' => 'error', 'finished' => time(), 'message' => 'Website folder not found']);
    exit(0);
}

$files = (int)trim((string)shell_exec('find ' . escapeshellarg($root) . ' -type f 2>/dev/null | wc -l'));

$cmd = 'timeout ' . TIMEOUT . ' nice -n 19 ionice -c3 /usr/bin/clamdscan -c ' . escapeshellarg(CONF)
     . ' --fdpass --infected --no-summary ' . escapeshellarg($root) . ' 2>&1';
exec($cmd, $lines, $code);

$found = []; $errors = 0; $total = 0;
foreach ($lines as $line) {
    if (preg_match('/^(.*): (\S+) FOUND$/', $line, $m)) {
        $total++;
        if (count($found) < MAX_LIST) {
            $found[] = ['file' => ltrim(substr($m[1], strlen($root)), '/'), 'signature' => $m[2]];
        }
    } elseif (stripos($line, 'ERROR') !== false || stripos($line, 'failed') !== false) {
        $errors++;
    }
}

$status = $code === 124 ? 'timeout' : (($code === 2 && !$total && $errors && !$found && $files > 0 && $errors >= $files) ? 'error' : 'done');
save($resultFile, [
    'domain'   => $host,
    'status'   => $status,
    'started'  => $started,
    'finished' => time(),
    'root'     => substr($root, strlen(VHOSTS)),
    'files'    => $files,
    'infected' => $total,
    'found'    => $found,
    'errors'   => $errors,
    'message'  => $status === 'timeout' ? 'Stopped after ' . (TIMEOUT / 60) . ' minutes' : ($status === 'error' ? 'ClamAV could not read the files' : ''),
]);
ftruncate($lock, 0);
flock($lock, LOCK_UN);
