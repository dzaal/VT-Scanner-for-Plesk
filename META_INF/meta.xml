        <entry_point id="main" place="tools" text="VT Site Scanner" icon="htdocs/images/icon.svg"/>
        <entry_point id="nav"  place="navigation" text="VT Site Scanner" icon="htdocs/images/icon.svg"/>
    </entry_points>
</module>
