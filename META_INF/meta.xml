<?xml version="1.0" encoding="utf-8"?>
<module>
    <id>virustotal-extension</id>
    <name>VT Site Scanner by Digizaal</name>
    <description>Monitor every website hosted in Plesk for malware, phishing and spam using the VirusTotal API. Smart caching, budget control, and daily background scanning.</description>
    <category>security</category>
    <version>1.8.2</version>
    <release>1</release>
    <vendor>Digizaal</vendor>
    <url>https://www.digizaal.nl</url>
    <plesk_min_version>18.0</plesk_min_version>
    <entry_points>
        <entry_point id="main" place="tools" text="VT Site Scanner" icon="htdocs/images/icon.png"/>
        <entry_point id="nav"  place="navigation" text="VT Site Scanner" icon="htdocs/images/icon.png"/>
    </entry_points>
</module>
